# Скопируйте в ~/.telegram-mcp/.env и заполните (chmod 600).
# Получить на https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Где хранить сессию и логи (по умолчанию ~/.telegram-mcp)
# TG_DATA_DIR=~/.telegram-mcp

# --- Защитные настройки ---
# 1 = ничего не отправлять, только логировать (для первых тестов)
TG_DRY_RUN=1

# Подтверждение отправки:
#   client — полагаемся на запрос разрешения Claude Code (send_message в списке "ask")
#   elicit — сервер сам спрашивает вас через MCP elicitation перед КАЖДОЙ отправкой
#            (если клиент не поддерживает elicitation — отправка отклоняется)
TG_CONFIRM_MODE=client

# Разрешённые получатели (id или @username через запятую). Пусто = любые.
# TG_ALLOWED_CHATS=@friend,123456789,-1001234567890

# Лимиты против спама
TG_MAX_MESSAGES_PER_HOUR=30
TG_MIN_SECONDS_BETWEEN_MESSAGES_PER_CHAT=20
