# Скопируйте в .env (cp .env.example .env) и заполните. Файл .env в git не попадает.
# Настоящие значения никому не пересылайте и не вставляйте в чаты.

# --- Обязательные ---
# Токен бота от @BotFather
BOT_TOKEN=
# Ключ Claude API: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Пароль PostgreSQL для docker compose (придумайте длинный случайный)
POSTGRES_PASSWORD=
# Для локального запуска без Docker укажите строку подключения сами:
# DATABASE_URL=postgresql://companion:ПАРОЛЬ@localhost:5432/companion

# --- Модель и размер ответов ---
# CHAT_MODEL=claude-haiku-5-5          # дешёвая; claude-sonnet-5-5 — качественнее и в ~20 раз дороже
# MEMORY_MODEL=claude-haiku-5-5        # резюме и факты; также запасная модель при близком лимите
# LLM_EFFORT=low                       # low | medium | high — глубина «размышлений» и расход
# MAX_REPLY_TOKENS=1000                # потолок длины одного ответа
# MAX_USER_MESSAGE_CHARS=2000          # длиннее — обрезается
# MAX_CONTEXT_MESSAGES=40              # сколько последних сообщений максимум идёт в запрос
# MAX_CONTEXT_CHARS=16000              # и не больше стольких символов
# KEEP_RECENT_MESSAGES=14              # после сжатия в контексте остаётся этот «хвост»
# SUMMARIZE_THRESHOLD=30               # при стольких несжатых сообщениях старое сжимается в резюме

# --- Деньги и лимиты ---
# ANTHROPIC_MONTHLY_BUDGET_USD=20      # жёсткий месячный лимит; при достижении вызовы прекращаются
# BUDGET_SOFT_RATIO=0.8                # после 80% бюджета — переход на MEMORY_MODEL
# PAID_APIS_DISABLED=0                 # 1 = аварийно отключить все платные вызовы
# DAILY_MESSAGES_PER_USER=80
# MESSAGES_PER_MINUTE=8
# LLM_MAX_RETRIES=2                    # повторы при 429/5xx/сбоях сети (0–5)
# LLM_TIMEOUT_SECONDS=45
# BREAKER_FAILURE_THRESHOLD=3          # после стольких ошибок подряд пауза в обращениях к API
# BREAKER_COOLDOWN_SECONDS=60

# --- Прочее ---
# PERSONA_PATH=persona/mira.toml       # файл характера персонажа
# SUPPORT_CONTACT=@your_support        # показывается в /help
# MESSAGE_RETENTION_DAYS=90            # сжатые в резюме сообщения удаляются через N дней
# LOG_LEVEL=INFO
# TELEGRAM_API_URL=                    # свой Bot API сервер (обычно не нужен)
