# Скопируйте в .env (cp .env.example .env) и заполните. Файл .env в git не попадает.
# Настоящие значения никому не пересылайте и не вставляйте в чаты.

# --- Обязательные ---
# Токен бота от @BotFather
BOT_TOKEN=
# Ключ Claude API: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Пароль PostgreSQL для docker compose (придумайте длинный случайный)
POSTGRES_PASSWORD=
# Для локального запуска без Docker укажите строку подключения сами:
# DATABASE_URL=postgresql://companion:ПАРОЛЬ@localhost:5432/companion

# --- Модель и размер ответов ---
# дешёвая; claude-sonnet-5-5 — качественнее и в ~20 раз дороже
# CHAT_MODEL=claude-haiku-5-5
# резюме и факты; также запасная модель при близком лимите
# MEMORY_MODEL=claude-haiku-5-5
# low | medium | high — глубина «размышлений» и расход
# LLM_EFFORT=low
# потолок длины одного ответа
# MAX_REPLY_TOKENS=1000
# длиннее — обрезается
# MAX_USER_MESSAGE_CHARS=2000
# сколько последних сообщений максимум идёт в запрос
# MAX_CONTEXT_MESSAGES=40
# и не больше стольких символов
# MAX_CONTEXT_CHARS=16000
# после сжатия в контексте остаётся этот «хвост»
# KEEP_RECENT_MESSAGES=14
# при стольких несжатых сообщениях старое сжимается в резюме
# SUMMARIZE_THRESHOLD=30

# --- Деньги и лимиты ---
# жёсткий месячный лимит; при достижении вызовы прекращаются
# ANTHROPIC_MONTHLY_BUDGET_USD=20
# после 80% бюджета — переход на MEMORY_MODEL
# BUDGET_SOFT_RATIO=0.8
# 1 = аварийно отключить все платные вызовы
# PAID_APIS_DISABLED=0
# DAILY_MESSAGES_PER_USER=80
# MESSAGES_PER_MINUTE=8
# повторы при 429/5xx/сбоях сети (0–5)
# LLM_MAX_RETRIES=2
# LLM_TIMEOUT_SECONDS=45
# после стольких ошибок подряд пауза в обращениях к API
# BREAKER_FAILURE_THRESHOLD=3
# BREAKER_COOLDOWN_SECONDS=60

# --- Прочее ---
# файл характера персонажа
# PERSONA_PATH=persona/mira.toml
# показывается в /help
# SUPPORT_CONTACT=@your_support
# сжатые в резюме сообщения удаляются через N дней
# MESSAGE_RETENTION_DAYS=90
# LOG_LEVEL=INFO
# свой Bot API сервер (обычно не нужен)
# TELEGRAM_API_URL=
