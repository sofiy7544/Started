# Скопируйте этот файл в .env (install.bat делает это сам) и заполните.
# Файл .env хранится только на вашем компьютере и не попадает в git.

# --- Обязательно ---
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую. Остальным бот откажет.
ALLOWED_TELEGRAM_IDS=

# --- Модели: нужен хотя бы один провайдер ---
# Ключ OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Ключ Claude (необязательно): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Локальные модели Ollama (необязательно), например http://localhost:11434/v1
OLLAMA_BASE_URL=

# --- Расходы ---
# Месячный лимит в долларах. При достижении бот перестаёт обращаться к платным моделям.
MONTHLY_BUDGET_USD=10
# Потолок стоимости одного запроса, USD
PER_REQUEST_COST_LIMIT_USD=0.25
# 1 = аварийно отключить все платные модели
PAID_APIS_DISABLED=0

# --- Необязательные настройки (значения по умолчанию подходят) ---
# Максимальная длина ответа в токенах
# MAX_REPLY_TOKENS=2000
# Сколько последних обменов сообщениями помнить в текущем разговоре
# MAX_HISTORY_TURNS=20
# Сообщений в минуту
# MESSAGES_PER_MINUTE=20
# Долгосрочная память: 1 — включена, 0 — выключена
# MEMORY_ENABLED=1
# Обрабатывать память каждые N сообщений
# MEMORY_BATCH_TURNS=3
# Максимум активных записей памяти (лишние, наименее ценные, уходят в архив)
# MEMORY_MAX_ACTIVE=300
# Голос: auto — OpenAI при наличии ключа, иначе бесплатные движки
# STT_PROVIDER=auto
# auto | openai | edge | none
# TTS_PROVIDER=auto
# Модель локального распознавания: tiny | base | small | medium | large-v3
# STT_LOCAL_MODEL=small
# Голосовые длиннее стольких секунд не распознаются (длинные — по частям по 2 минуты)
# MAX_VOICE_SECONDS=900
# Сколько символов ответа озвучивать (≈ 2 минуты речи); остальное — текстом
# MAX_TTS_CHARS=1500
# Вложения (фото, документы, аудио, видео): 1 — включены, 0 — выключены
# MEDIA_ENABLED=1
# Максимальный размер файла, МБ. Облачный Telegram отдаёт ботам до 20 МБ; больше — только
# со своим сервером Bot API (TELEGRAM_API_URL)
# MAX_FILE_MB=20
# Аудио и видео: распознавать речь не дольше стольких секунд
# MAX_MEDIA_SECONDS=1800
# Кадров видео для анализа (дальше модель запрашивает нужный отрезок сама)
# MAX_VIDEO_FRAMES=10
# Сколько часов хранить сами файлы (извлечённый текст остаётся с разговором)
# MEDIA_RETENTION_HOURS=24
# Сколько секунд ждать подпись/вопрос после файла без подписи
# MEDIA_WAIT_SECONDS=4
# Сколько резервных копий базы хранить
# BACKUP_KEEP=14
# Подробность логов: INFO или DEBUG
# LOG_LEVEL=INFO
